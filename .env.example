# Supabase (la MISMA base de almuerzo.cl). La anon key solo se usa para iniciar sesión y leer el propio perfil.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Conexión directa a Postgres con el rol integraciones_service (sin permisos sobre las tablas de almuerzo.cl).
# Nunca la service_role key. La contraseña del rol se asigna fuera de las migraciones.
DATABASE_URL=

# Clave AES-256 (32 bytes en base64) con la que se cifran las credenciales del sistema externo. Va en Secret Manager.
#   openssl rand -base64 32
CREDENTIALS_KEY=

# Secreto con el que Cloud Scheduler llama a /api/cron/*  (mínimo 16 caracteres)
CRON_SECRET=
